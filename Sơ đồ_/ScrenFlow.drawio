        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam shadowing false\nskinparam linetype ortho\nskinparam nodesep 28\nskinparam ranksep 35\n\nskinparam rectangle {\n  BorderColor #555555\n  BorderThickness 1\n  FontName \&quot;Segoe UI\&quot;, Arial, sans-serif\n  FontSize 12\n  FontColor #1E293B\n}\n\n&#39; Bảng màu Pastel theo phong cách mẫu ảnh\nskinparam rectangle&lt;&lt;Public&gt;&gt; {\n  BackgroundColor #D5E8D4\n  BorderColor #82B366\n}\n\nskinparam rectangle&lt;&lt;Auth&gt;&gt; {\n  BackgroundColor #F8CECC\n  BorderColor #B85450\n}\n\nskinparam rectangle&lt;&lt;Admin&gt;&gt; {\n  BackgroundColor #FFE6CC\n  BorderColor #D79B00\n}\n\nskinparam rectangle&lt;&lt;Farmer&gt;&gt; {\n  BackgroundColor #E1D5E7\n  BorderColor #9673A6\n}\n\nskinparam rectangle&lt;&lt;Buyer&gt;&gt; {\n  BackgroundColor #FFF2CC\n  BorderColor #D6B656\n}\n\nskinparam rectangle&lt;&lt;Consumer&gt;&gt; {\n  BackgroundColor #DAE8FC\n  BorderColor #6C8EBF\n}\n\n&#39; --- CÁC MÀN HÌNH PUBLIC (GUEST) ---\nrectangle \&quot;Home Screen\&quot; as SCR_HOME &lt;&lt;Public&gt;&gt;\nrectangle \&quot;Public Product Catalog\&quot; as SCR_MKT_CATALOG &lt;&lt;Public&gt;&gt;\nrectangle \&quot;Product Detail\&quot; as SCR_PROD_DETAIL &lt;&lt;Public&gt;&gt;\nrectangle \&quot;Farm Profile\&quot; as SCR_FARM_PROFILE &lt;&lt;Public&gt;&gt;\nrectangle \&quot;QR Traceability Detail\&quot; as SCR_TRACE_DETAIL &lt;&lt;Public&gt;&gt;\n\n&#39; --- CÁC MÀN HÌNH AUTHENTICATION ---\nrectangle \&quot;User Login\&quot; as SCR_LOGIN &lt;&lt;Auth&gt;&gt;\nrectangle \&quot;Account Register\&quot; as SCR_REG &lt;&lt;Auth&gt;&gt;\nrectangle \&quot;B2B Registration &amp; KYC\&quot; as SCR_REG_B2B &lt;&lt;Auth&gt;&gt;\nrectangle \&quot;Password Reset\&quot; as SCR_FORGOT_PWD &lt;&lt;Auth&gt;&gt;\nrectangle \&quot;User Profile\&quot; as SCR_PROFILE &lt;&lt;Auth&gt;&gt;\nrectangle \&quot;Password Change\&quot; as SCR_CHG_PWD &lt;&lt;Auth&gt;&gt;\n\n&#39; --- KHỐI POST-LOGIN CÁC ROLE WORKSPACE ---\nrectangle \&quot;Post-Login\&quot; as PostLogin {\n  rectangle \&quot;Admin Dashboard\&quot; as SCR_ADM_DASH &lt;&lt;Admin&gt;&gt;\n  rectangle \&quot;Farmer Dashboard\&quot; as SCR_FAR_DASH &lt;&lt;Farmer&gt;&gt;\n  rectangle \&quot;B2B Procurement Workspace\&quot; as SCR_B2B_SEARCH &lt;&lt;Buyer&gt;&gt;\n  rectangle \&quot;Consumer Home &amp; Orders\&quot; as SCR_CON_HOME &lt;&lt;Consumer&gt;&gt;\n}\n\n&#39; --- LUỒNG ADMIN ---\nrectangle \&quot;User Management\&quot; as SCR_USER_MGMT &lt;&lt;Admin&gt;&gt;\nrectangle \&quot;User Account Detail\&quot; as SCR_USER_DETAIL &lt;&lt;Admin&gt;&gt;\nrectangle \&quot;KYC Applications\&quot; as SCR_KYC_VERIFY &lt;&lt;Admin&gt;&gt;\nrectangle \&quot;Listing Moderation\&quot; as SCR_MODERATE_PROD &lt;&lt;Admin&gt;&gt;\nrectangle \&quot;Category Settings\&quot; as SCR_CAT_CONFIG &lt;&lt;Admin&gt;&gt;\nrectangle \&quot;Complaint Resolution\&quot; as SCR_COMPLAINT_RESOLVE &lt;&lt;Admin&gt;&gt;\n\n&#39; --- LUỒNG FARMER ---\nrectangle \&quot;Crop Season Management\&quot; as SCR_SEASON_MGMT &lt;&lt;Farmer&gt;&gt;\nrectangle \&quot;E-Farming Logs\&quot; as SCR_FARMING_LOG &lt;&lt;Farmer&gt;&gt;\nrectangle \&quot;Batch &amp; QR Management\&quot; as SCR_BATCH_QR &lt;&lt;Farmer&gt;&gt;\nrectangle \&quot;Product Listing Form\&quot; as SCR_LISTING_FORM &lt;&lt;Farmer&gt;&gt;\nrectangle \&quot;Farmer Orders Processing\&quot; as SCR_ORDER_PROCESS &lt;&lt;Farmer&gt;&gt;\n\n&#39; --- LUỒNG BUYER B2B ---\nrectangle \&quot;Supplier Capacity Profile\&quot; as SCR_B2B_SUPPLIER &lt;&lt;Buyer&gt;&gt;\nrectangle \&quot;Wholesale / Pre-order Form\&quot; as SCR_B2B_ORDER &lt;&lt;Buyer&gt;&gt;\nrectangle \&quot;Draft Offtake Contract\&quot; as SCR_B2B_CONTRACT &lt;&lt;Buyer&gt;&gt;\nrectangle \&quot;Contract Fulfillment Tracker\&quot; as SCR_B2B_FULFILL &lt;&lt;Buyer&gt;&gt;\n\n&#39; --- LUỒNG CONSUMER ---\nrectangle \&quot;Shopping Cart\&quot; as SCR_CART &lt;&lt;Consumer&gt;&gt;\nrectangle \&quot;Retail Checkout\&quot; as SCR_CHECKOUT &lt;&lt;Consumer&gt;&gt;\nrectangle \&quot;Payment Gateway\&quot; as SCR_PAYMENT &lt;&lt;Consumer&gt;&gt;\nrectangle \&quot;Order Tracking\&quot; as SCR_ORDER_TRACK &lt;&lt;Consumer&gt;&gt;\n\n&#39; ================= LIÊN KẾT ĐIỀU HƯỚNG =================\n\n&#39; Public flow\nSCR_HOME -down-&gt; SCR_MKT_CATALOG\nSCR_MKT_CATALOG -right-&gt; SCR_PROD_DETAIL\nSCR_PROD_DETAIL -down-&gt; SCR_FARM_PROFILE\nSCR_PROD_DETAIL -right-&gt; SCR_TRACE_DETAIL\n\n&#39; Auth flow\nSCR_HOME -right-&gt; SCR_LOGIN\nSCR_LOGIN -up-&gt; SCR_FORGOT_PWD\nSCR_LOGIN -down-&gt; SCR_REG\nSCR_REG -down-&gt; SCR_REG_B2B\nSCR_LOGIN -right-&gt; PostLogin\nSCR_PROFILE -up-&gt; SCR_CHG_PWD\n\n&#39; Admin branches\nSCR_ADM_DASH -right-&gt; SCR_USER_MGMT\nSCR_USER_MGMT -right-&gt; SCR_USER_DETAIL\nSCR_ADM_DASH -down-&gt; SCR_KYC_VERIFY\nSCR_ADM_DASH -down-&gt; SCR_MODERATE_PROD\nSCR_ADM_DASH -right-&gt; SCR_CAT_CONFIG\nSCR_KYC_VERIFY -right-&gt; SCR_COMPLAINT_RESOLVE\n\n&#39; Farmer branches\nSCR_FAR_DASH -right-&gt; SCR_SEASON_MGMT\nSCR_SEASON_MGMT -right-&gt; SCR_FARMING_LOG\nSCR_SEASON_MGMT -down-&gt; SCR_BATCH_QR\nSCR_BATCH_QR -right-&gt; SCR_LISTING_FORM\nSCR_FAR_DASH -down-&gt; SCR_ORDER_PROCESS\n\n&#39; Buyer B2B branches\nSCR_B2B_SEARCH -right-&gt; SCR_B2B_SUPPLIER\nSCR_B2B_SUPPLIER -right-&gt; SCR_B2B_ORDER\nSCR_B2B_SUPPLIER -down-&gt; SCR_B2B_CONTRACT\nSCR_B2B_CONTRACT -right-&gt; SCR_B2B_FULFILL\n\n&#39; Consumer branches\nSCR_PROD_DETAIL -down-&gt; SCR_CART\nSCR_CART -right-&gt; SCR_CHECKOUT\nSCR_CHECKOUT -right-&gt; SCR_PAYMENT\nSCR_PAYMENT -right-&gt; SCR_ORDER_TRACK\nSCR_CON_HOME -down-&gt; SCR_PROFILE\nSCR_CON_HOME -right-&gt; SCR_ORDER_TRACK\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="1sBFFaCSt3yOri6C6CnA-271">
