        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Consumer Purchase Flow\n\n|Consumer|\nstart\n:Search and view product;\n:Add product to cart;\n:Checkout;\n:Enter delivery address;\n:Apply reward points (optional);\n\n|AgriSustain System|\n:Validate stock, price,\\naddress and reward points;\n\nif (Valid checkout?) then (Yes)\n  :Create order\\n[Pending Payment];\n\n  |Payment Gateway|\n  :Create VietQR payment code;\n\n  |AgriSustain System|\n  :Display QR code and amount;\n\n  |Consumer|\n  :Scan QR and complete payment;\n\n  |Payment Gateway|\n  :Send payment webhook / result;\n\n  |AgriSustain System|\n  if (Payment successful?) then (Yes)\n    :Update order to Paid / Confirmed;\n    :Reduce inventory;\n\n    |Notification Service|\n    :Send order confirmation;\n\n    |Consumer|\n    :Receive confirmation;\n    :View order tracking;\n    stop\n\n  else (No)\n    :Update order to Payment Failed / Expired;\n\n    |Notification Service|\n    :Send payment failure notification;\n\n    |Consumer|\n    :Retry payment or cancel order;\n    stop\n  endif\n\nelse (No)\n  |Consumer|\n  :Show validation error;\n  :Update cart or checkout information;\n  stop\nendif\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="pBsH6M1eBYg07SGPYt9s-62">
