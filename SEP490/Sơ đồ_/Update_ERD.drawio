        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n&#39; --- Configuration ---\nhide circle\nskinparam spot none\nskinparam roundcorner 5\nskinparam shadowing false\nskinparam monochrome false\nskinparam packageStyle rectangle\n\nskinparam class {\n    BackgroundColor #FDFEFE\n    BorderColor #2C3E50\n    ArrowColor #2980B9\n    FontName Arial\n    FontSize 12\n}\n\n&#39; --- Entities and Attributes (No IDs) ---\n\nentity \&quot;User\&quot; as User {\n    Username\n    Email\n    PasswordHash\n    FullName\n    PhoneNumber\n    Role\n    Status\n    CreatedAt\n}\n\nentity \&quot;FarmerProfile\&quot; as FarmerProfile {\n    FarmName\n    ProductionScale\n    BusinessLicenseNumber\n    Address\n    ProvinceCode\n    VerificationStatus\n    ApprovedAt\n}\n\nentity \&quot;FarmCertificate\&quot; as FarmCertificate {\n    CertificateType\n    CertificateNumber\n    IssuedBy\n    IssueDate\n    ExpiryDate\n    DocumentUrl\n    VerificationStatus\n}\n\nentity \&quot;Category\&quot; as Category {\n    CategoryName\n    Description\n    IsActive\n}\n\nentity \&quot;Product\&quot; as Product {\n    ProductName\n    Description\n    Unit\n    BaseRetailPrice\n    WholesaleMinQuantity\n    WholesalePrice\n    ApprovalStatus\n    IsPublished\n}\n\nentity \&quot;HarvestBatch\&quot; as HarvestBatch {\n    BatchCode\n    EstimatedHarvestDate\n    ActualHarvestDate\n    HarvestYield\n    AvailableQuantity\n    Status\n}\n\nentity \&quot;CultivationLog\&quot; as CultivationLog {\n    ActionDate\n    ActionType\n    DetailDescription\n    InputMaterial\n    PerformedBy\n    ImageUrl\n}\n\nentity \&quot;TraceabilityQRCode\&quot; as TraceabilityQRCode {\n    QRContentString\n    TargetUrl\n    ScanCount\n    IsRevoked\n    GeneratedAt\n}\n\nentity \&quot;Order\&quot; as Order {\n    OrderType\n    OrderDate\n    ExpectedDeliveryDate\n    ShippingAddress\n    TotalAmount\n    OrderStatus\n    TrackingNumber\n}\n\nentity \&quot;OrderItem\&quot; as OrderItem {\n    Quantity\n    UnitPrice\n    DiscountApplied\n    SubTotal\n}\n\nentity \&quot;B2BContract\&quot; as B2BContract {\n    ContractNumber\n    TermsAndConditions\n    DepositAmount\n    PaymentTerms\n    DigitalSignatureStatus\n    SignedDate\n}\n\nentity \&quot;PaymentTransaction\&quot; as PaymentTransaction {\n    TransactionCode\n    GatewayProvider\n    Amount\n    PaymentStatus\n    WebhookPayload\n    PaidAt\n}\n\nentity \&quot;ReviewDispute\&quot; as ReviewDispute {\n    RatingStars\n    Comment\n    DisputeReason\n    EvidenceImages\n    DisputeStatus\n    AdminResolutionNotes\n    ResolvedAt\n}\n\nentity \&quot;RegionalPriceBenchmark\&quot; as RegionalPriceBenchmark {\n    RegionName\n    ProvinceName\n    MinPrice\n    MaxPrice\n    AveragePrice\n    RecordedDate\n}\n\n&#39; --- Straight Line Relationships with Cardinality (1 - 1, 1 - N) ---\n\nUser \&quot;1\&quot; -- \&quot;1\&quot; FarmerProfile : \&quot;defines identity\&quot;\nFarmerProfile \&quot;1\&quot; -- \&quot;N\&quot; FarmCertificate : \&quot;registers\&quot;\nFarmerProfile \&quot;1\&quot; -- \&quot;N\&quot; Product : \&quot;cultivates and lists\&quot;\n\nCategory \&quot;1\&quot; -- \&quot;N\&quot; Product : \&quot;classifies\&quot;\nCategory \&quot;1\&quot; -- \&quot;N\&quot; RegionalPriceBenchmark : \&quot;tracks pricing for\&quot;\n\nProduct \&quot;1\&quot; -- \&quot;N\&quot; HarvestBatch : \&quot;produces batches\&quot;\nHarvestBatch \&quot;1\&quot; -- \&quot;N\&quot; CultivationLog : \&quot;documents farming\&quot;\nHarvestBatch \&quot;1\&quot; -- \&quot;1\&quot; TraceabilityQRCode : \&quot;represented by\&quot;\n\nUser \&quot;1\&quot; -- \&quot;N\&quot; Order : \&quot;places purchase\&quot;\nOrder \&quot;1\&quot; -- \&quot;N\&quot; OrderItem : \&quot;contains items\&quot;\nProduct \&quot;1\&quot; -- \&quot;N\&quot; OrderItem : \&quot;included in\&quot;\nHarvestBatch \&quot;1\&quot; -- \&quot;N\&quot; OrderItem : \&quot;deducts stock from\&quot;\n\nOrder \&quot;1\&quot; -- \&quot;1\&quot; B2BContract : \&quot;formalized by\&quot;\nOrder \&quot;1\&quot; -- \&quot;N\&quot; PaymentTransaction : \&quot;settles via\&quot;\nOrder \&quot;1\&quot; -- \&quot;N\&quot; ReviewDispute : \&quot;receives feedback or claim\&quot;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="OgFk-m72jpxlf277ce2W-1">
