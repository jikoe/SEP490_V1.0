<mxfile host="app.diagrams.net">
  <diagram name="Trang-1" id="zMQfzzL2Nte9BlOkisMG">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n&#39; --- CẤU HÌNH GIAO DIỆN &amp; TẮT BIỂU TƯỢNG &#39;E&#39; ---\nhide circle\nskinparam linetype ortho\nskinparam roundcorner 5\nskinparam shadowing false\nskinparam class {\n    BackgroundColor White\n    ArrowColor #2C3E50\n    BorderColor #2C3E50\n}\n\n&#39; =========================================================\n&#39; NHÓM 1: TÀI KHOẢN VÀ CÁC THỰC THỂ PHÂN QUYỀN (1 - 1)\n&#39; =========================================================\n\nentity \&quot;Accounts\&quot; as Accounts {\n    * AccountID : PK\n    --\n    Email\n    PasswordHash\n    PhoneNumber\n    Role\n    Status\n    CreatedAt\n    UpdatedAt\n}\n\nentity \&quot;Farmers\&quot; as Farmers {\n    * FarmerID : PK\n    --\n    * AccountID : FK\n    FarmName\n    RepresentativeName\n    Address\n    Region\n    FarmSizeHectares\n    ReputationScore\n    CreatedAt\n}\n\nentity \&quot;Buyers\&quot; as Buyers {\n    * BuyerID : PK\n    --\n    * AccountID : FK\n    CompanyName\n    TaxCode\n    BusinessLicenseURL\n    Address\n    BuyerType\n    ReputationScore\n    CreatedAt\n}\n\nentity \&quot;Consumers\&quot; as Consumers {\n    * ConsumerID : PK\n    --\n    * AccountID : FK\n    FullName\n    DefaultShippingAddress\n    RewardPoints\n    CreatedAt\n}\n\nentity \&quot;BankPartners\&quot; as BankPartners {\n    * BankID : PK\n    --\n    * AccountID : FK\n    BankName\n    FintechLicenseCode\n    Status\n}\n\nentity \&quot;CertificationBodies\&quot; as CertificationBodies {\n    * BodyID : PK\n    --\n    * AccountID : FK\n    BodyName\n    GovernmentApprovedCode\n    Status\n}\n\n&#39; =========================================================\n&#39; NHÓM 2: MÙA VỤ, NHẬT KÝ &amp; CHỨNG NHẬN\n&#39; =========================================================\n\nentity \&quot;Certifications\&quot; as Certifications {\n    * CertID : PK\n    --\n    * FarmerID : FK\n    * IssuedByBodyID : FK\n    CertType\n    CertNumber\n    IssueDate\n    ExpiryDate\n    CertificateURL\n    Status\n}\n\nentity \&quot;CropSeasons\&quot; as CropSeasons {\n    * SeasonID : PK\n    --\n    * FarmerID : FK\n    CropName\n    StartDate\n    ExpectedHarvestDate\n    EstimatedYieldTons\n    ActualYieldTons\n    Status\n}\n\nentity \&quot;FarmingLogs\&quot; as FarmingLogs {\n    * LogID : PK\n    --\n    * SeasonID : FK\n    LogDate\n    ActivityDescription\n    InputsUsed\n    Notes\n}\n\n&#39; =========================================================\n&#39; NHÓM 3: SẢN PHẨM VÀ LÔ HÀNG (TRUY XUẤT NGUỒN GỐC)\n&#39; =========================================================\n\nentity \&quot;Categories\&quot; as Categories {\n    * CategoryID : PK\n    --\n    CategoryName\n    Description\n}\n\nentity \&quot;Products\&quot; as Products {\n    * ProductID : PK\n    --\n    * FarmerID : FK\n    * CategoryID : FK\n    ProductName\n    Description\n    Unit\n    BasePricePerUnit\n    IsApproved\n    ProductImageURL\n    CreatedAt\n}\n\nentity \&quot;ProductBatches\&quot; as ProductBatches {\n    * BatchID : PK\n    --\n    * ProductID : FK\n    * SeasonID : FK\n    BatchCode\n    QuantityAvailable\n    HarvestDate\n    ExpiryDate\n    QRCodeData\n    BatchStatus\n    DisposalMethod\n    CreatedAt\n}\n\n&#39; =========================================================\n&#39; NHÓM 4: ĐƠN HÀNG VÀ HỢP ĐỒNG BAO TIÊU\n&#39; =========================================================\n\nentity \&quot;OfftakeContracts\&quot; as OfftakeContracts {\n    * ContractID : PK\n    --\n    * FarmerID : FK\n    * BuyerID : FK\n    CropName\n    QuantityCommitted\n    FixedPricePerUnit\n    StartDate\n    EndDate\n    ContractTerms\n    ContractDocumentURL\n    Status\n}\n\nentity \&quot;Orders\&quot; as Orders {\n    * OrderID : PK\n    --\n    * AccountID : FK\n    OrderType\n    OrderDate\n    TotalAmount\n    PlatformFee\n    OrderStatus\n    ShippingAddress\n    EstimatedDeliveryDate\n    ActualDeliveryDate\n}\n\n&#39; Bảng trung gian giải quyết quan hệ Nhiều - Nhiều (N - N) giữa Orders và Products\nentity \&quot;OrderItems\&quot; as OrderItems {\n    * OrderItemID : PK\n    --\n    * OrderID : FK\n    * ProductID : FK\n    BatchID : FK\n    Quantity\n    UnitPrice\n}\n\n&#39; =========================================================\n&#39; NHÓM 5: TÀI CHÍNH, TÍN DỤNG &amp; BẢO HIỂM\n&#39; =========================================================\n\nentity \&quot;FinancialTransactions\&quot; as FinancialTransactions {\n    * TransactionID : PK\n    --\n    OrderID : FK\n    * AccountID : FK\n    Amount\n    TransactionType\n    PaymentMethod\n    GatewayRefCode\n    Status\n    CreatedAt\n}\n\nentity \&quot;CreditApplications\&quot; as CreditApplications {\n    * CreditID : PK\n    --\n    * FarmerID : FK\n    * BankID : FK\n    AmountRequested\n    InterestRate\n    TermMonths\n    Status\n    AppliedDate\n    ReviewedDate\n}\n\nentity \&quot;CropInsurances\&quot; as CropInsurances {\n    * InsuranceID : PK\n    --\n    * FarmerID : FK\n    * BankID : FK\n    * SeasonID : FK\n    PremiumAmount\n    CoverageAmount\n    PolicyTerms\n    Status\n}\n\n&#39; =========================================================\n&#39; NHÓM 6: DOANH THU &amp; GÓI DỊCH VỤ\n&#39; =========================================================\n\nentity \&quot;SubscriptionTiers\&quot; as SubscriptionTiers {\n    * TierID : PK\n    --\n    TierName\n    PricePerMonth\n    FeaturesDescription\n}\n\nentity \&quot;BuyerSubscriptions\&quot; as BuyerSubscriptions {\n    * SubscriptionID : PK\n    --\n    * BuyerID : FK\n    * TierID : FK\n    StartDate\n    EndDate\n    Status\n}\n\nentity \&quot;MarketReports\&quot; as MarketReports {\n    * ReportID : PK\n    --\n    Title\n    PublishDate\n    Price\n    PDFUrl\n}\n\n&#39; Bảng trung gian giải quyết quan hệ Nhiều - Nhiều (N - N) giữa Buyers và MarketReports\nentity \&quot;ReportPurchases\&quot; as ReportPurchases {\n    * PurchaseID : PK\n    --\n    * BuyerID : FK\n    * ReportID : FK\n    PurchaseDate\n    PricePaid\n}\n\n&#39; =========================================================\n&#39; NHÓM 7: ĐÁNH GIÁ, KHIẾU NẠI &amp; THÔNG BÁO\n&#39; =========================================================\n\nentity \&quot;ProductReviews\&quot; as ProductReviews {\n    * ReviewID : PK\n    --\n    * OrderID : FK\n    * ProductID : FK\n    * ReviewerAccountID : FK\n    Rating\n    Comment\n    CreatedAt\n}\n\nentity \&quot;Complaints\&quot; as Complaints {\n    * ComplaintID : PK\n    --\n    * OrderID : FK\n    * ComplainantAccountID : FK\n    HandledByAdminID : FK\n    Reason\n    Status\n    ResolutionDetails\n    CreatedAt\n    UpdatedAt\n}\n\nentity \&quot;Notifications\&quot; as Notifications {\n    * Id : PK\n    --\n    * AccountID : FK\n    Title\n    Content\n    Type\n    Channel\n    IsRead\n    EmailStatus\n    CreatedAt\n}\n\n&#39; =========================================================\n&#39; QUAN HỆ ERD (CROW&#39;S FOOT NOTATION)\n&#39; =========================================================\n\n&#39; 1 - 1: Phân quyền tài khoản\nAccounts ||--|| Farmers : \&quot;1 - 1\&quot;\nAccounts ||--|| Buyers : \&quot;1 - 1\&quot;\nAccounts ||--|| Consumers : \&quot;1 - 1\&quot;\nAccounts ||--|| BankPartners : \&quot;1 - 1\&quot;\nAccounts ||--|| CertificationBodies : \&quot;1 - 1\&quot;\n\n&#39; 1 - N: Canh tác &amp; Chứng chỉ\nFarmers ||--o{ CropSeasons : \&quot;1 - N\&quot;\nFarmers ||--o{ Certifications : \&quot;1 - N\&quot;\nCertificationBodies ||--o{ Certifications : \&quot;1 - N\&quot;\nCropSeasons ||--o{ FarmingLogs : \&quot;1 - N\&quot;\n\n&#39; 1 - N: Phân loại &amp; Sản phẩm\nCategories ||--o{ Products : \&quot;1 - N\&quot;\nFarmers ||--o{ Products : \&quot;1 - N\&quot;\nProducts ||--o{ ProductBatches : \&quot;1 - N\&quot;\nCropSeasons ||--o{ ProductBatches : \&quot;1 - N\&quot;\n\n&#39; 1 - N: Hợp đồng\nFarmers ||--o{ OfftakeContracts : \&quot;1 - N\&quot;\nBuyers ||--o{ OfftakeContracts : \&quot;1 - N\&quot;\n\n&#39; N - N thông qua bảng trung gian OrderItems\nAccounts ||--o{ Orders : \&quot;1 - N\&quot;\nOrders ||--|{ OrderItems : \&quot;1 - N\&quot;\nProducts ||--o{ OrderItems : \&quot;1 - N\&quot;\nProductBatches ||--o{ OrderItems : \&quot;1 - N\&quot;\n\n&#39; 1 - N: Giao dịch &amp; Tín dụng\nOrders ||--o{ FinancialTransactions : \&quot;1 - N\&quot;\nAccounts ||--o{ FinancialTransactions : \&quot;1 - N\&quot;\nFarmers ||--o{ CreditApplications : \&quot;1 - N\&quot;\nBankPartners ||--o{ CreditApplications : \&quot;1 - N\&quot;\nFarmers ||--o{ CropInsurances : \&quot;1 - N\&quot;\nBankPartners ||--o{ CropInsurances : \&quot;1 - N\&quot;\nCropSeasons ||--o{ CropInsurances : \&quot;1 - N\&quot;\n\n&#39; N - N thông qua bảng trung gian ReportPurchases &amp; Gói đăng ký\nBuyers ||--o{ BuyerSubscriptions : \&quot;1 - N\&quot;\nSubscriptionTiers ||--o{ BuyerSubscriptions : \&quot;1 - N\&quot;\nBuyers ||--o{ ReportPurchases : \&quot;1 - N\&quot;\nMarketReports ||--o{ ReportPurchases : \&quot;1 - N\&quot;\n\n&#39; 1 - N: Đánh giá &amp; Phản hồi\nOrders ||--o{ ProductReviews : \&quot;1 - N\&quot;\nProducts ||--o{ ProductReviews : \&quot;1 - N\&quot;\nAccounts ||--o{ ProductReviews : \&quot;1 - N\&quot;\nOrders ||--o{ Complaints : \&quot;1 - N\&quot;\nAccounts ||--o{ Complaints : \&quot;1 - N\&quot;\nAccounts ||--o{ Complaints : \&quot;1 - N (Admin)\&quot;\nAccounts ||--o{ Notifications : \&quot;1 - N\&quot;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="mhQbsi07-_t3ZG-LjIKX-964">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
