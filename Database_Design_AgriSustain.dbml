// AgriSustain logical database design
// Derived from Report-3_Software Requirement Specification.docx
// SQL Server 2019+; paste into dbdiagram.io. UTC storage; Vietnamese UI.
Project AgriSustain {
  database_type: 'MSSQL'
  Note: 'UUID keys and Unicode; see Database_Design_Decisions.md for workflow assumptions.'
}

Table accounts {
  account_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  email varchar(255) [not null, unique]
  phone_number varchar(30) [not null, unique]
  password_hash varchar(255) [not null]
  role nvarchar(30) [not null, note: 'Admin, Farmer, Buyer, Consumer, Bank, Certifier']
  status nvarchar(30) [not null, default: 'pending']
  created_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]
  updated_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]
  full_name nvarchar(50)
  avatar_url nvarchar(max)
  email_verified_at datetime2(3)
  phone_verified_at datetime2(3)
  failed_login_count int [not null, default: 0]
  locked_until datetime2(3)
  terms_accepted_at datetime2(3)
  version rowversion [not null]
  checks {
    `failed_login_count >= 0` [name: 'CK_accounts_1']
    `LEN(full_name) BETWEEN 2 AND 50` [name: 'CK_accounts_2']
    `role IN (N'Admin', N'Farmer', N'Buyer', N'Consumer', N'Bank', N'Certifier')` [name: 'CK_accounts_3']
    `status IN (N'pending', N'approved', N'rejected', N'suspended')` [name: 'CK_accounts_4']
  }
}

Table farmers {
  farmer_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  account_id uniqueidentifier [not null, unique, ref: > accounts.account_id]
  farm_name nvarchar(100) [not null]
  representative_name nvarchar(50) [not null]
  address nvarchar(200) [not null]
  region nvarchar(150)
  farm_size_hectares decimal(12,2) [not null]
  reputation_score decimal(3,2) [not null, default: 5.00, note: 'CHECK: 0.00..5.00']
  created_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]
  latitude decimal(9,6)
  longitude decimal(9,6)
  farm_type nvarchar(30) [not null]
  short_description nvarchar(300)
  farm_photo_url nvarchar(max)
  checks {
    `reputation_score BETWEEN 0 AND 5` [name: 'CK_farmers_1']
    `farm_size_hectares > 0` [name: 'CK_farmers_2']
    `latitude BETWEEN -90 AND 90` [name: 'CK_farmers_3']
    `longitude BETWEEN -180 AND 180` [name: 'CK_farmers_4']
    `farm_type IN (N'individual', N'cooperative')` [name: 'CK_farmers_5']
  }
}

Table buyers {
  buyer_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  account_id uniqueidentifier [not null, unique, ref: > accounts.account_id]
  company_name nvarchar(255) [not null]
  tax_code varchar(50) [not null, unique]
  business_license_url nvarchar(max)
  address nvarchar(500)
  buyer_type nvarchar(50) [not null, note: 'Supermarket, ProcessingPlant, Exporter, Restaurant']
  reputation_score decimal(3,2) [not null, default: 5.00, note: 'CHECK: 0.00..5.00']
  created_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]
  checks {
    `reputation_score BETWEEN 0 AND 5` [name: 'CK_buyers_1']
    `buyer_type IN (N'Supermarket', N'ProcessingPlant', N'Exporter', N'Restaurant')` [name: 'CK_buyers_2']
  }
}

Table consumers {
  consumer_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  account_id uniqueidentifier [not null, unique, ref: > accounts.account_id]
  full_name nvarchar(50) [not null]
  gender nvarchar(20)
  birth_date date
  reward_points_balance int [not null, default: 0]
  created_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]
  checks {
    `reward_points_balance >= 0` [name: 'CK_consumers_1']
    `LEN(full_name) BETWEEN 2 AND 50` [name: 'CK_consumers_2']
    `gender IN (N'male', N'female', N'other')` [name: 'CK_consumers_3']
  }
}

Table bank_partners {
  bank_partner_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  account_id uniqueidentifier [not null, unique, ref: > accounts.account_id]
  bank_name nvarchar(255) [not null]
  license_number varchar(100) [not null, unique]
  contact_person nvarchar(255)
  max_credit_limit decimal(18,2)
  interest_rate_min decimal(5,2)
  created_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]
  checks {
    `interest_rate_min BETWEEN 0 AND 100` [name: 'CK_bank_partners_1']
    `max_credit_limit >= 0` [name: 'CK_bank_partners_2']
  }
}

Table certification_bodies {
  certification_body_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  account_id uniqueidentifier [not null, unique, ref: > accounts.account_id]
  organization_name nvarchar(255) [not null]
  accreditation_code varchar(100) [not null, unique]
  website nvarchar(max)
  contact_email nvarchar(255)
  created_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]
}

Table categories {
  category_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  parent_category_id uniqueidentifier [ref: > categories.category_id]
  category_name nvarchar(100) [not null]
  description nvarchar(500)
  icon_url nvarchar(max)
  is_active bit [not null, default: 1]

  Indexes { (parent_category_id, category_name) [unique] }
  priority int [not null, default: 0]
  created_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]
  updated_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]
  version rowversion [not null]
  checks {
    `priority >= 0` [name: 'CK_categories_1']
    `LEN(category_name) BETWEEN 2 AND 100` [name: 'CK_categories_2']
    `parent_category_id IS NULL OR parent_category_id <> category_id` [name: 'CK_categories_3']
  }
}

Table products {
  product_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  farmer_id uniqueidentifier [not null, ref: > farmers.farmer_id]
  category_id uniqueidentifier [not null, ref: > categories.category_id]
  product_name nvarchar(255) [not null]
  description nvarchar(max)
  unit nvarchar(30) [not null]
  retail_price decimal(18,2) [not null]
  b2b_price decimal(18,2)
  approval_status nvarchar(30) [not null, default: 'pending']
  created_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]
  updated_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]

  Indexes {
    (category_id, approval_status)
    (farmer_id, created_at)
  }
  is_active bit [not null, default: 1]
  archived_at datetime2(3)
  origin nvarchar(200) [not null]
  specifications nvarchar(max)
  view_count bigint [not null, default: 0]
  checks {
    `retail_price > 0` [name: 'CK_products_1']
    `b2b_price > 0` [name: 'CK_products_2']
    `view_count >= 0` [name: 'CK_products_3']
    `approval_status IN (N'pending', N'approved', N'rejected')` [name: 'CK_products_5']
  }
}

Table crop_seasons {
  crop_season_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  farmer_id uniqueidentifier [not null, ref: > farmers.farmer_id]
  season_name nvarchar(255) [not null]
  crop_type nvarchar(100) [not null]
  area_hectares decimal(12,2)
  planting_date date
  expected_harvest_date date
  expected_yield_tons decimal(14,3)
  status nvarchar(30) [not null, default: 'planned']
  actual_yield_tons decimal(14,3)
  checks {
    `area_hectares > 0` [name: 'CK_crop_seasons_1']
    `expected_yield_tons >= 0` [name: 'CK_crop_seasons_2']
    `actual_yield_tons >= 0` [name: 'CK_crop_seasons_3']
    `expected_harvest_date >= planting_date` [name: 'CK_crop_seasons_4']
    `status IN (N'planned', N'in_progress', N'harvested', N'completed', N'cancelled')` [name: 'CK_crop_seasons_5']
  }
}

Table farming_logs {
  farming_log_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  crop_season_id uniqueidentifier [not null, ref: > crop_seasons.crop_season_id]
  activity_type nvarchar(50) [not null, note: 'Sowing, Fertilizing, PesticideApp, Irrigation, Harvest']
  log_date date [not null]
  inputs_used nvarchar(max)
  quantity_used decimal(14,3)
  image_url nvarchar(max)
  performed_by nvarchar(255)

  Indexes { (crop_season_id, log_date) }
  checks {
    `quantity_used >= 0` [name: 'CK_farming_logs_1']
    `activity_type IN (N'Sowing', N'Fertilizing', N'PesticideApp', N'Irrigation', N'Harvest')` [name: 'CK_farming_logs_2']
  }
}

Table product_batches {
  product_batch_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  product_id uniqueidentifier [not null, ref: > products.product_id]
  crop_season_id uniqueidentifier [not null, ref: > crop_seasons.crop_season_id]
  batch_code varchar(100) [not null, unique]
  harvest_date date [not null]
  quantity_on_hand decimal(14,3) [not null]
  quantity_reserved decimal(14,3) [not null, default: 0]
  status nvarchar(30) [not null, default: 'active']
  Note: 'QuantityAvailable = quantity_on_hand - quantity_reserved. Exclude expired/inactive stock.'
  expiry_date date
  qr_code_url nvarchar(max)

  Indexes { (product_id, expiry_date) }
  checks {
    `quantity_on_hand >= quantity_reserved` [name: 'CK_product_batches_1']
    `quantity_reserved >= 0` [name: 'CK_product_batches_2']
    `expiry_date >= harvest_date` [name: 'CK_product_batches_3']
    `status IN (N'active', N'exhausted', N'expired', N'inactive')` [name: 'CK_product_batches_4']
  }
}

Table certifications {
  certification_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  farmer_id uniqueidentifier [not null, ref: > farmers.farmer_id]
  certification_body_id uniqueidentifier [ref: > certification_bodies.certification_body_id]
  certificate_type nvarchar(50) [not null, note: 'VietGAP, GlobalGAP, Organic, OCOP']
  certificate_number varchar(100) [not null, unique]
  issued_date date [not null]
  expiry_date date [not null]
  document_url nvarchar(max) [not null]
  verification_status nvarchar(30) [not null, default: 'pending']

  Indexes { (expiry_date, verification_status) }
  reviewed_by_account_id uniqueidentifier [ref: > accounts.account_id]
  reviewed_at datetime2(3)
  review_reason nvarchar(1000)
  checks {
    `expiry_date >= issued_date` [name: 'CK_certifications_1']
    `certificate_type IN (N'VietGAP', N'GlobalGAP', N'Organic', N'OCOP')` [name: 'CK_certifications_2']
    `verification_status IN (N'pending', N'verified', N'rejected', N'expired')` [name: 'CK_certifications_3']
  }
}

Table crop_insurances {
  crop_insurance_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  crop_season_id uniqueidentifier [not null, ref: > crop_seasons.crop_season_id]
  policy_number varchar(100) [not null, unique]
  insurer_name nvarchar(255) [not null]
  coverage_amount decimal(18,2) [not null]
  premium_amount decimal(18,2) [not null]
  start_date date [not null]
  end_date date [not null]
  status nvarchar(30) [not null, note: 'Active, Claimed, Expired, Cancelled']
  checks {
    `end_date >= start_date` [name: 'CK_crop_insurances_1']
    `coverage_amount >= 0` [name: 'CK_crop_insurances_2']
    `premium_amount >= 0` [name: 'CK_crop_insurances_3']
    `status IN (N'active', N'claimed', N'expired', N'cancelled')` [name: 'CK_crop_insurances_4']
  }
}

Table offtake_contracts {
  offtake_contract_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  buyer_id uniqueidentifier [not null, ref: > buyers.buyer_id]
  farmer_id uniqueidentifier [not null, ref: > farmers.farmer_id]
  crop_season_id uniqueidentifier [not null, ref: > crop_seasons.crop_season_id]
  contract_code varchar(100) [not null, unique]
  agreed_quantity_tons decimal(14,3) [not null]
  agreed_price_per_ton decimal(18,2) [not null]
  total_value decimal(18,2) [not null]
  deposit_amount decimal(18,2)
  status nvarchar(30) [not null, default: 'draft']
  signed_date date
  version_number int [not null, default: 1]
  terms nvarchar(max) [not null]
  starts_at datetime2(3)
  ends_at datetime2(3)
  created_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]
  checks {
    `agreed_quantity_tons > 0` [name: 'CK_offtake_contracts_1']
    `agreed_price_per_ton > 0` [name: 'CK_offtake_contracts_2']
    `deposit_amount IS NULL OR deposit_amount <= total_value` [name: 'CK_offtake_contracts_3']
    `ends_at >= starts_at` [name: 'CK_offtake_contracts_4']
    `version_number > 0` [name: 'CK_offtake_contracts_5']
    `total_value >= 0` [name: 'CK_offtake_contracts_6']
    `status IN (N'draft', N'pending_sign', N'active', N'fulfilled', N'defaulted', N'terminated')` [name: 'CK_offtake_contracts_7']
  }
}

Table subscription_tiers {
  subscription_tier_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  tier_name nvarchar(100) [not null, unique]
  monthly_fee decimal(18,2) [not null]
  features_json nvarchar(max) [note: 'Validate with ISJSON() in SQL Server']
  is_active bit [not null, default: 1]
  checks {
    `features_json IS NULL OR ISJSON(features_json) = 1` [name: 'CK_subscription_tiers_1']
    `monthly_fee >= 0` [name: 'CK_subscription_tiers_2']
  }
}

Table buyer_subscriptions {
  subscription_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  buyer_id uniqueidentifier [not null, ref: > buyers.buyer_id]
  subscription_tier_id uniqueidentifier [not null, ref: > subscription_tiers.subscription_tier_id]
  start_date date [not null]
  end_date date [not null]
  auto_renew bit [not null, default: 0]
  status nvarchar(30) [not null, note: 'Active, Cancelled, Expired']

  Indexes { (end_date, status) }
  checks {
    `end_date >= start_date` [name: 'CK_buyer_subscriptions_1']
    `status IN (N'active', N'cancelled', N'expired')` [name: 'CK_buyer_subscriptions_2']
  }
}

Table orders {
  order_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  account_id uniqueidentifier [not null, ref: > accounts.account_id]
  order_code varchar(100) [not null, unique]
  order_type nvarchar(30) [not null]
  subtotal decimal(18,2) [not null]
  delivery_fee decimal(18,2) [not null, default: 0]
  voucher_discount decimal(18,2) [not null, default: 0]
  points_discount decimal(18,2) [not null, default: 0]
  redeemed_points int [not null, default: 0]
  final_amount decimal(18,2) [not null]
  payment_method nvarchar(30) [not null, note: 'VietQR, PayOS, Escrow']
  order_status nvarchar(30) [not null, default: 'pending_payment']
  created_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]
  updated_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]

  Indexes {
    (account_id, order_status, created_at)
    (account_id, checkout_key) [unique]
    (order_status, payment_expires_at)
  }
  checkout_key varchar(100) [not null]
  recipient_name nvarchar(100) [not null]
  recipient_phone varchar(30) [not null]
  province nvarchar(100) [not null]
  district nvarchar(100) [not null]
  ward nvarchar(100) [not null]
  address_detail nvarchar(255) [not null]
  delivery_method nvarchar(30) [not null]
  order_notes nvarchar(300)
  payment_expires_at datetime2(3) [not null]
  cancellation_reason nvarchar(1000)
  version rowversion [not null]
  checks {
    `subtotal > 0` [name: 'CK_orders_1']
    `redeemed_points >= 0` [name: 'CK_orders_2']
    `final_amount = subtotal + delivery_fee - voucher_discount - points_discount` [name: 'CK_orders_3']
    `payment_expires_at > created_at` [name: 'CK_orders_4']
    `delivery_fee >= 0` [name: 'CK_orders_5']
    `voucher_discount >= 0` [name: 'CK_orders_6']
    `points_discount >= 0` [name: 'CK_orders_7']
    `order_type IN (N'retail', N'preorder', N'b2b_wholesale')` [name: 'CK_orders_8']
    `order_status IN (N'pending_payment', N'paid', N'processing', N'shipping', N'partially_completed', N'completed', N'partially_cancelled', N'cancelled')` [name: 'CK_orders_9']
    `payment_method IN (N'VietQR', N'PayOS', N'Escrow')` [name: 'CK_orders_10']
    `delivery_method IN (N'standard', N'fresh_express')` [name: 'CK_orders_11']
  }
}

Table order_items {
  order_item_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  order_id uniqueidentifier [not null, ref: > orders.order_id]
  product_id uniqueidentifier [not null, ref: > products.product_id]
  product_batch_id uniqueidentifier [ref: > product_batches.product_batch_id]
  quantity decimal(14,3) [not null]
  unit_price decimal(18,2) [not null]
  subtotal decimal(18,2) [not null]

  Indexes { order_id }
  fulfillment_id uniqueidentifier [not null, ref: > order_fulfillments.fulfillment_id]
  preorder_commitment_id uniqueidentifier [ref: > preorder_commitments.commitment_id]
  product_name_snapshot nvarchar(255) [not null]
  unit_snapshot nvarchar(30) [not null]
  batch_code_snapshot varchar(100)
  checks {
    `quantity > 0` [name: 'CK_order_items_1']
    `unit_price > 0` [name: 'CK_order_items_2']
    `subtotal = ROUND(quantity * unit_price, 2)` [name: 'CK_order_items_3']
  }
}

Table financial_transactions {
  financial_transaction_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  order_id uniqueidentifier [ref: > orders.order_id]
  offtake_contract_id uniqueidentifier [ref: > offtake_contracts.offtake_contract_id]
  gateway_transaction_ref varchar(255)
  gateway_name nvarchar(50) [not null, note: 'VietQR, PayOS, SePay']
  amount decimal(18,2) [not null]
  currency char(3) [not null, default: 'VND']
  transaction_type nvarchar(30) [not null, note: 'OrderPayment, Deposit, EscrowRelease, Refund']
  status nvarchar(30) [not null, default: 'pending']
  transaction_time datetime2(3) [not null]

  Indexes {
    // Non-null gateway references use a filtered unique index in SQL DDL.
    (order_id, status, transaction_time)
  }
  subscription_id uniqueidentifier [ref: > buyer_subscriptions.subscription_id]
  purchase_id uniqueidentifier [ref: > report_purchases.purchase_id]
  commitment_id uniqueidentifier [ref: > preorder_commitments.commitment_id]
  original_transaction_id uniqueidentifier [ref: > financial_transactions.financial_transaction_id]
  refund_fulfillment_id uniqueidentifier [ref: > order_fulfillments.fulfillment_id]
  idempotency_key varchar(100) [not null, unique]
  paid_at datetime2(3)
  next_check_at datetime2(3)
  expires_at datetime2(3)
  created_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]
  checks {
    `amount > 0` [name: 'CK_financial_transactions_1']
    `(CASE WHEN order_id IS NULL THEN 0 ELSE 1 END + CASE WHEN offtake_contract_id IS NULL THEN 0 ELSE 1 END + CASE WHEN subscription_id IS NULL THEN 0 ELSE 1 END + CASE WHEN purchase_id IS NULL THEN 0 ELSE 1 END + CASE WHEN commitment_id IS NULL THEN 0 ELSE 1 END) = 1` [name: 'CK_financial_transactions_2']
    `(transaction_type = N'Refund' AND original_transaction_id IS NOT NULL) OR (transaction_type <> N'Refund' AND original_transaction_id IS NULL)` [name: 'CK_financial_transactions_3']
    `refund_fulfillment_id IS NULL OR (transaction_type = N'Refund' AND order_id IS NOT NULL)` [name: 'CK_financial_transactions_4']
    `gateway_name IN (N'VietQR', N'PayOS', N'SePay')` [name: 'CK_financial_transactions_5']
    `transaction_type IN (N'OrderPayment', N'Deposit', N'EscrowRelease', N'Refund', N'SubscriptionPayment', N'ReportPayment')` [name: 'CK_financial_transactions_6']
    `status IN (N'pending', N'success', N'failed')` [name: 'CK_financial_transactions_7']
  }
}

Table market_reports {
  report_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  title nvarchar(500) [not null]
  region nvarchar(150)
  crop_category nvarchar(150)
  price_amount decimal(18,2) [not null]
  published_date date [not null]
  file_url nvarchar(max) [not null]
  is_free_for_subscribers bit [not null, default: 0]
  checks {
    `price_amount >= 0` [name: 'CK_market_reports_1']
  }
}

Table report_purchases {
  purchase_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  buyer_id uniqueidentifier [not null, ref: > buyers.buyer_id]
  market_report_id uniqueidentifier [not null, ref: > market_reports.report_id]
  price_paid decimal(18,2) [not null]
  purchased_at datetime2(3) [not null]

  Indexes { (buyer_id, market_report_id) [unique] }
  checks {
    `price_paid >= 0` [name: 'CK_report_purchases_1']
  }
}

Table product_reviews {
  product_review_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  order_item_id uniqueidentifier [not null, unique, ref: > order_items.order_item_id]
  account_id uniqueidentifier [not null, ref: > accounts.account_id]
  rating_stars smallint [not null, note: 'CHECK: 1..5']
  comment_text nvarchar(max)
  is_hidden_by_admin bit [not null, default: 0]
  created_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]

  moderated_by_account_id uniqueidentifier [ref: > accounts.account_id]
  moderation_reason nvarchar(1000)
  moderated_at datetime2(3)
  checks {
    `rating_stars BETWEEN 1 AND 5` [name: 'CK_product_reviews_1']
  }
}

Table complaints {
  complaint_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  order_id uniqueidentifier [not null, ref: > orders.order_id]
  complainant_account_id uniqueidentifier [not null, ref: > accounts.account_id]
  reason_category nvarchar(50) [not null, note: 'Defective, Crushed, WrongItem, Expired']
  description_text nvarchar(max) [not null]
  evidence_image_url nvarchar(max)
  resolution_status nvarchar(30) [not null, default: 'submitted']
  admin_note nvarchar(max)
  created_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]

  Indexes { (resolution_status, created_at) }
  fulfillment_id uniqueidentifier [ref: > order_fulfillments.fulfillment_id]
  handled_by_account_id uniqueidentifier [ref: > accounts.account_id]
  resolved_at datetime2(3)
  checks {
    `reason_category IN (N'Defective', N'Crushed', N'WrongItem', N'Expired')` [name: 'CK_complaints_1']
    `resolution_status IN (N'submitted', N'under_review', N'refunded', N'rejected', N'closed')` [name: 'CK_complaints_2']
  }
}

Table notifications {
  notification_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  account_id uniqueidentifier [not null, ref: > accounts.account_id]
  type nvarchar(50) [not null]
  channel nvarchar(30) [not null]
  title nvarchar(255) [not null]
  content nvarchar(max) [not null]
  status nvarchar(30) [not null]
  read_at datetime2(3)
  created_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]

  Indexes {
    (account_id, read_at)
    (status, next_retry_at)
  }
  retry_count int [not null, default: 0]
  next_retry_at datetime2(3)
  sent_at datetime2(3)
  last_error nvarchar(1000)
  checks {
    `retry_count BETWEEN 0 AND 3` [name: 'CK_notifications_1']
    `channel IN (N'in_app', N'email', N'system')` [name: 'CK_notifications_2']
    `type IN (N'Order', N'Contract', N'System', N'Credit', N'Subscription', N'Certificate', N'KYC')` [name: 'CK_notifications_3']
    `status IN (N'pending', N'sent', N'failed', N'permanent_failure')` [name: 'CK_notifications_4']
  }
}

Table credit_applications {
  credit_application_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  applicant_account_id uniqueidentifier [not null, ref: > accounts.account_id]
  bank_partner_id uniqueidentifier [not null, ref: > bank_partners.bank_partner_id]
  requested_amount decimal(18,2) [not null]
  loan_term_months int [not null]
  purpose_description nvarchar(max)
  status nvarchar(30) [not null, default: 'submitted']
  application_date date [not null]
  checks {
    `loan_term_months > 0` [name: 'CK_credit_applications_1']
    `requested_amount >= 0` [name: 'CK_credit_applications_2']
    `status IN (N'submitted', N'under_review', N'approved', N'disbursed', N'rejected')` [name: 'CK_credit_applications_3']
  }
}

// AUTHENTICATION AND KYC
Table verification_challenges {
  challenge_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  account_id uniqueidentifier [ref: > accounts.account_id]
  target_email varchar(255) [not null]
  purpose nvarchar(30) [not null]
  code_hash varchar(255) [not null]
  expires_at datetime2(3) [not null]
  verified_at datetime2(3)
  consumed_at datetime2(3)
  invalidated_at datetime2(3)
  failed_attempts int [not null, default: 0]
  resend_available_at datetime2(3) [not null]
  created_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]
  Indexes {
    (target_email, purpose, created_at)
    expires_at
  }
  Note: 'Registration challenge may have no account yet. Store HMAC/hash only; invalidate old challenges on resend. Reset must verify account and consume once.'
  checks {
    `failed_attempts >= 0` [name: 'CK_verification_challenges_1']
    `expires_at > created_at` [name: 'CK_verification_challenges_2']
    `consumed_at IS NULL OR verified_at IS NOT NULL` [name: 'CK_verification_challenges_3']
    `purpose IN (N'registration', N'password_reset', N'email_change', N'phone_change')` [name: 'CK_verification_challenges_4']
  }
}

Table auth_sessions {
  session_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  account_id uniqueidentifier [not null, ref: > accounts.account_id]
  token_hash varchar(255) [not null, unique]
  expires_at datetime2(3) [not null]
  revoked_at datetime2(3)
  created_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]
  Indexes { (account_id, revoked_at) }
  checks {
    `expires_at > created_at` [name: 'CK_auth_sessions_1']
  }
}

Table kyc_applications {
  application_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  account_id uniqueidentifier [not null, ref: > accounts.account_id]
  proposed_profile_json nvarchar(max) [not null]
  status nvarchar(30) [not null, default: 'submitted']
  reviewer_account_id uniqueidentifier [ref: > accounts.account_id]
  reason nvarchar(1000)
  reviewed_at datetime2(3)
  submitted_at datetime2(3) [not null]
  version rowversion [not null]
  Indexes { (status, submitted_at) }
  Note: 'Stores initial/re-KYC proposals before approved Farmer/Buyer profile exists. Apply approved proposal and create/update profile atomically.'
  checks {
    `ISJSON(proposed_profile_json) = 1` [name: 'CK_kyc_applications_1']
    `reviewed_at IS NULL OR reviewer_account_id IS NOT NULL` [name: 'CK_kyc_applications_2']
    `status IN (N'submitted', N'under_review', N'approved', N'rejected', N'changes_requested')` [name: 'CK_kyc_applications_3']
  }
}

Table kyc_documents {
  document_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  application_id uniqueidentifier [not null, ref: > kyc_applications.application_id]
  document_type nvarchar(50) [not null]
  file_url nvarchar(max) [not null]
  uploaded_at datetime2(3) [not null]
}

Table account_addresses {
  address_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  account_id uniqueidentifier [not null, ref: > accounts.account_id]
  recipient_name nvarchar(100) [not null]
  recipient_phone varchar(30) [not null]
  province nvarchar(100) [not null]
  district nvarchar(100) [not null]
  ward nvarchar(100) [not null]
  address_detail nvarchar(255) [not null]
  is_default bit [not null, default: 0]
  created_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]
  updated_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]
  Note: 'One default address per account via filtered SQL unique index. Checkout copies values to orders.'
}

// CATALOGUE AND PREORDER
Table product_images {
  image_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  product_id uniqueidentifier [not null, ref: > products.product_id]
  image_url nvarchar(max) [not null]
  alt_text nvarchar(255)
  sort_order int [not null, default: 0]
  Indexes { (product_id, sort_order) [unique] }
  checks {
    `sort_order >= 0` [name: 'CK_product_images_1']
  }
}

Table product_moderation_history {
  moderation_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  product_id uniqueidentifier [not null, ref: > products.product_id]
  actor_account_id uniqueidentifier [not null, ref: > accounts.account_id]
  action nvarchar(30) [not null]
  reason nvarchar(1000)
  occurred_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]
  checks {
    `action NOT IN (N'reject', N'delist') OR LEN(LTRIM(RTRIM(reason))) > 0 AND reason IS NOT NULL` [name: 'CK_product_moderation_history_1']
    `action IN (N'approve', N'reject', N'delist', N'resubmit')` [name: 'CK_product_moderation_history_2']
  }
}

Table preorder_campaigns {
  campaign_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  product_id uniqueidentifier [not null, ref: > products.product_id]
  crop_season_id uniqueidentifier [not null, ref: > crop_seasons.crop_season_id]
  target_quantity decimal(14,3) [not null]
  reserved_quantity decimal(14,3) [not null, default: 0]
  price_per_unit decimal(18,2) [not null]
  deposit_percent decimal(5,2) [not null, default: 0]
  opens_at datetime2(3) [not null]
  closes_at datetime2(3) [not null]
  status nvarchar(30) [not null, default: 'scheduled']
  created_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]
  Indexes { (status, opens_at, closes_at) }
  checks {
    `target_quantity > 0` [name: 'CK_preorder_campaigns_1']
    `reserved_quantity BETWEEN 0 AND target_quantity` [name: 'CK_preorder_campaigns_2']
    `price_per_unit > 0` [name: 'CK_preorder_campaigns_3']
    `deposit_percent BETWEEN 0 AND 100` [name: 'CK_preorder_campaigns_4']
    `closes_at > opens_at` [name: 'CK_preorder_campaigns_5']
    `status IN (N'scheduled', N'active', N'closed', N'completed', N'cancelled')` [name: 'CK_preorder_campaigns_6']
  }
}

Table preorder_commitments {
  commitment_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  campaign_id uniqueidentifier [not null, ref: > preorder_campaigns.campaign_id]
  buyer_id uniqueidentifier [not null, ref: > buyers.buyer_id]
  quantity decimal(14,3) [not null]
  unit_price decimal(18,2) [not null]
  deposit_amount decimal(18,2) [not null, default: 0]
  status nvarchar(30) [not null, default: 'pending_payment']
  checkout_key varchar(100) [not null]
  expires_at datetime2(3) [not null]
  created_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]
  Indexes { (buyer_id, checkout_key) [unique] }
  Note: 'Capacity reservation belongs to campaign, not harvested stock. Deposit payment targets this commitment.'
  checks {
    `quantity > 0` [name: 'CK_preorder_commitments_1']
    `unit_price > 0` [name: 'CK_preorder_commitments_2']
    `expires_at > created_at` [name: 'CK_preorder_commitments_3']
    `deposit_amount >= 0` [name: 'CK_preorder_commitments_4']
    `status IN (N'pending_payment', N'confirmed', N'fulfilled', N'cancelled', N'expired')` [name: 'CK_preorder_commitments_5']
  }
}

// CHECKOUT AND PER-FARMER FULFILLMENT
Table carts {
  cart_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  account_id uniqueidentifier [not null, unique, ref: > accounts.account_id]
  updated_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]
}

Table cart_items {
  cart_item_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  cart_id uniqueidentifier [not null, ref: > carts.cart_id]
  product_id uniqueidentifier [not null, ref: > products.product_id]
  product_batch_id uniqueidentifier [ref: > product_batches.product_batch_id]
  quantity decimal(14,3) [not null]
  price_when_added decimal(18,2) [not null]
  added_at datetime2(3) [not null]
  Indexes { (cart_id, product_id, product_batch_id) [unique] }
  checks {
    `quantity > 0` [name: 'CK_cart_items_1']
    `price_when_added > 0` [name: 'CK_cart_items_2']
  }
}

Table order_fulfillments {
  fulfillment_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  order_id uniqueidentifier [not null, ref: > orders.order_id]
  farmer_id uniqueidentifier [not null, ref: > farmers.farmer_id]
  status nvarchar(30) [not null, default: 'pending_payment']
  subtotal decimal(18,2) [not null]
  delivery_fee decimal(18,2) [not null, default: 0]
  voucher_discount decimal(18,2) [not null, default: 0]
  points_discount decimal(18,2) [not null, default: 0]
  platform_fee decimal(18,2) [not null, default: 0]
  packaging_requirements nvarchar(500)
  requested_delivery_at datetime2(3)
  cancellation_reason nvarchar(1000)
  created_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]
  updated_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]
  version rowversion [not null]
  Indexes {
    (order_id, farmer_id) [unique]
    (farmer_id, status, created_at)
    (fulfillment_id, order_id) [unique]
  }
  Note: 'One checkout order, independent fulfillment per farmer. Discounts/fees allocated deterministically; reject/refund only the affected fulfillment.'
  checks {
    `subtotal > 0` [name: 'CK_order_fulfillments_1']
    `voucher_discount + points_discount <= subtotal + delivery_fee` [name: 'CK_order_fulfillments_2']
    `status <> N'cancelled' OR (cancellation_reason IS NOT NULL AND LEN(LTRIM(RTRIM(cancellation_reason))) > 0)` [name: 'CK_order_fulfillments_3']
    `delivery_fee >= 0` [name: 'CK_order_fulfillments_4']
    `points_discount >= 0` [name: 'CK_order_fulfillments_5']
    `platform_fee >= 0` [name: 'CK_order_fulfillments_6']
    `status IN (N'pending_payment', N'confirmed', N'processing', N'awaiting_shipper', N'in_transit', N'delivered', N'cancelled')` [name: 'CK_order_fulfillments_7']
  }
}

Table shipments {
  shipment_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  fulfillment_id uniqueidentifier [not null, unique, ref: > order_fulfillments.fulfillment_id]
  carrier_name nvarchar(100)
  tracking_code varchar(100)
  cold_chain_required bit [not null, default: 0]
  status nvarchar(30) [not null, default: 'pending']
  packed_at datetime2(3)
  handed_over_at datetime2(3)
  estimated_delivery_at datetime2(3)
  delivered_at datetime2(3)
  Note: 'Manual/simulated carrier in Report 3 v1; no external shipping API assumed.'
  checks {
    `status IN (N'pending', N'packed', N'in_transit', N'delivered', N'cancelled')` [name: 'CK_shipments_1']
  }
}

Table order_status_history {
  history_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  order_id uniqueidentifier [not null, ref: > orders.order_id]
  fulfillment_id uniqueidentifier [ref: > order_fulfillments.fulfillment_id]
  actor_account_id uniqueidentifier [ref: > accounts.account_id]
  old_status nvarchar(30)
  new_status nvarchar(30) [not null]
  reason nvarchar(1000)
  occurred_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]
  Indexes { (order_id, occurred_at) }
}

Table inventory_reservations {
  reservation_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  order_item_id uniqueidentifier [not null, unique, ref: > order_items.order_item_id]
  product_batch_id uniqueidentifier [not null, ref: > product_batches.product_batch_id]
  quantity decimal(14,3) [not null]
  status nvarchar(30) [not null, default: 'reserved']
  expires_at datetime2(3) [not null]
  consumed_at datetime2(3)
  released_at datetime2(3)
  created_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]
  Indexes { (status, expires_at) }
  Note: 'Checkout increments reserved. Paid reservations remain held; unpaid expiry releases once. Farmer acceptance decrements both on_hand and reserved once.'
  checks {
    `quantity > 0` [name: 'CK_inventory_reservations_1']
    `expires_at > created_at` [name: 'CK_inventory_reservations_2']
    `(status = N'reserved' AND consumed_at IS NULL AND released_at IS NULL) OR (status = N'consumed' AND consumed_at IS NOT NULL AND released_at IS NULL) OR (status = N'released' AND consumed_at IS NULL AND released_at IS NOT NULL)` [name: 'CK_inventory_reservations_3']
    `status IN (N'reserved', N'consumed', N'released')` [name: 'CK_inventory_reservations_4']
  }
}

// CONTRACT SIGNATURES AND OBLIGATIONS
Table contract_signatures {
  signature_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  offtake_contract_id uniqueidentifier [not null, ref: > offtake_contracts.offtake_contract_id]
  signer_account_id uniqueidentifier [not null, ref: > accounts.account_id]
  signer_role nvarchar(20) [not null]
  contract_version int [not null]
  method nvarchar(30) [not null]
  document_hash varchar(128) [not null]
  signed_at datetime2(3) [not null]
  Indexes { (offtake_contract_id, contract_version, signer_role) [unique] }
  checks {
    `contract_version > 0` [name: 'CK_contract_signatures_1']
    `signer_role IN (N'farmer', N'buyer')` [name: 'CK_contract_signatures_2']
    `method IN (N'electronic_confirmation', N'digital_signature')` [name: 'CK_contract_signatures_3']
  }
}

Table contract_milestones {
  milestone_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  offtake_contract_id uniqueidentifier [not null, ref: > offtake_contracts.offtake_contract_id]
  title nvarchar(200) [not null]
  obligation nvarchar(max)
  due_at datetime2(3) [not null]
  amount_due decimal(18,2)
  quantity_due_tons decimal(14,3)
  status nvarchar(30) [not null, default: 'pending']
  completed_at datetime2(3)
  invoice_code varchar(100)
  acceptance_note nvarchar(1000)
  Indexes { (status, due_at) }
  checks {
    `amount_due >= 0` [name: 'CK_contract_milestones_1']
    `quantity_due_tons >= 0` [name: 'CK_contract_milestones_2']
    `status IN (N'pending', N'completed', N'cancelled')` [name: 'CK_contract_milestones_3']
  }
}

// PROMOTIONS AND REWARD LEDGER
Table vouchers {
  voucher_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  code varchar(50) [not null, unique]
  name nvarchar(100) [not null]
  discount_type nvarchar(20) [not null]
  discount_value decimal(18,2) [not null]
  max_discount decimal(18,2)
  minimum_subtotal decimal(18,2) [not null, default: 0]
  usage_limit int [not null]
  per_account_limit int [not null, default: 1]
  starts_at datetime2(3) [not null]
  ends_at datetime2(3) [not null]
  is_active bit [not null, default: 1]
  restrict_products bit [not null, default: 0]
  restrict_accounts bit [not null, default: 0]
  checks {
    `discount_value > 0` [name: 'CK_vouchers_1']
    `minimum_subtotal >= 0` [name: 'CK_vouchers_2']
    `usage_limit > 0` [name: 'CK_vouchers_3']
    `per_account_limit > 0` [name: 'CK_vouchers_4']
    `ends_at > starts_at` [name: 'CK_vouchers_5']
    `discount_type <> N'percent' OR discount_value <= 100` [name: 'CK_vouchers_6']
    `max_discount >= 0` [name: 'CK_vouchers_7']
    `discount_type IN (N'fixed', N'percent')` [name: 'CK_vouchers_8']
  }
}

Table voucher_products {
  voucher_product_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  voucher_id uniqueidentifier [not null, ref: > vouchers.voucher_id]
  product_id uniqueidentifier [not null, ref: > products.product_id]
  Indexes { (voucher_id, product_id) [unique] }
}

Table voucher_accounts {
  voucher_account_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  voucher_id uniqueidentifier [not null, ref: > vouchers.voucher_id]
  account_id uniqueidentifier [not null, ref: > accounts.account_id]
  Indexes { (voucher_id, account_id) [unique] }
}

Table voucher_redemptions {
  redemption_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  voucher_id uniqueidentifier [not null, ref: > vouchers.voucher_id]
  order_id uniqueidentifier [not null, unique, ref: > orders.order_id]
  account_id uniqueidentifier [not null, ref: > accounts.account_id]
  code_snapshot varchar(50) [not null]
  discount_amount decimal(18,2) [not null]
  status nvarchar(30) [not null, default: 'reserved']
  created_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]
  Indexes { (voucher_id, account_id, status) }
  checks {
    `discount_amount >= 0` [name: 'CK_voucher_redemptions_1']
    `status IN (N'reserved', N'consumed', N'released')` [name: 'CK_voucher_redemptions_2']
  }
}

Table reward_point_transactions {
  point_transaction_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  consumer_id uniqueidentifier [not null, ref: > consumers.consumer_id]
  order_id uniqueidentifier [ref: > orders.order_id]
  delta int [not null]
  reason nvarchar(30) [not null]
  idempotency_key varchar(100) [not null, unique]
  occurred_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]
  Indexes { (consumer_id, occurred_at) }
  checks {
    `delta <> 0` [name: 'CK_reward_point_transactions_1']
    `reason IN (N'earn', N'redeem', N'refund', N'adjustment')` [name: 'CK_reward_point_transactions_2']
  }
}

// PAYMENTS, AUDIT AND EVIDENCE
Table payment_events {
  event_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  financial_transaction_id uniqueidentifier [not null, ref: > financial_transactions.financial_transaction_id]
  gateway_name nvarchar(50) [not null]
  event_key varchar(255) [not null]
  source nvarchar(30) [not null]
  verified_at datetime2(3)
  received_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]
  processed_at datetime2(3)
  last_error nvarchar(1000)
  Indexes { (gateway_name, event_key) [unique] }
  Note: 'Webhook/Reconcile events have deterministic idempotency keys. Persist safe metadata only; never credentials or OTP payloads.'
  checks {
    `source IN (N'webhook', N'reconciliation')` [name: 'CK_payment_events_1']
  }
}

Table audit_logs {
  audit_log_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  actor_account_id uniqueidentifier [ref: > accounts.account_id]
  target_id uniqueidentifier [not null, note: 'Polymorphic reference; validate target by entity_type in application']
  entity_type nvarchar(50) [not null]
  action nvarchar(50) [not null]
  old_value nvarchar(max)
  new_value nvarchar(max)
  reason nvarchar(1000)
  occurred_at datetime2(3) [not null, default: `SYSUTCDATETIME()`]
  Indexes { (entity_type, target_id, occurred_at) }
  Note: 'Append-only to application principal. Exclude passwords, session hashes, OTP and confidential documents from snapshots. Archive via privileged maintenance principal.'
}

Table complaint_evidence {
  evidence_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  complaint_id uniqueidentifier [not null, ref: > complaints.complaint_id]
  file_url nvarchar(max) [not null]
  uploaded_at datetime2(3) [not null]
}

Table review_images {
  review_image_id uniqueidentifier [pk, default: `NEWSEQUENTIALID()`]
  product_review_id uniqueidentifier [not null, ref: > product_reviews.product_review_id]
  image_url nvarchar(max) [not null]
}

TableGroup Identity_and_KYC {
  accounts
  farmers
  buyers
  consumers
  bank_partners
  certification_bodies
  verification_challenges
  auth_sessions
  kyc_applications
  kyc_documents
  account_addresses
}

TableGroup Catalogue_and_Traceability {
  categories
  products
  product_images
  product_moderation_history
  crop_seasons
  farming_logs
  product_batches
  certifications
  crop_insurances
}

TableGroup Checkout_and_Delivery {
  carts
  cart_items
  orders
  order_items
  order_fulfillments
  shipments
  inventory_reservations
  order_status_history
}

TableGroup Preorders_and_Contracts {
  preorder_campaigns
  preorder_commitments
  offtake_contracts
  contract_signatures
  contract_milestones
}

TableGroup Promotions_and_Rewards {
  vouchers
  voucher_products
  voucher_accounts
  voucher_redemptions
  reward_point_transactions
}

TableGroup Finance_and_Membership {
  financial_transactions
  payment_events
  credit_applications
  subscription_tiers
  buyer_subscriptions
  market_reports
  report_purchases
}

TableGroup Feedback_and_Operations {
  product_reviews
  review_images
  complaints
  complaint_evidence
  notifications
  audit_logs
}
