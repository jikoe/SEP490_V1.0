# Copy this file to .env (same folder) and fill in real values. .env is git-ignored.
# Keys use "__" in place of ":" (Goship__AccessToken = Goship:AccessToken).

# Token from POST https://sandbox.goship.io/api/v2/login (needed for the address catalog too).
Goship__AccessToken=

# Turn on shipping-fee quotes once pickup locations are configured.
Goship__Enabled=false
Goship__BaseUrl=https://sandbox.goship.io/api/v2/

# Pickup city/district (Goship codes) per FarmerProfileId; repeat for each farm.
# The sandbox only returns rates for parcels sent from Ha Noi (100000) or TP.HCM (700000);
# other origins get an empty list (MSG117), so test with a Ha Noi pickup such as 100000/100100.
# Goship__PickupLocations__123__City=100000
# Goship__PickupLocations__123__District=100300
